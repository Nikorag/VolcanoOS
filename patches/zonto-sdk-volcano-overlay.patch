+// ── Volcano OS overlay bridge ───────────────────────────────────────────────────
+//
+// The Volcano OS launcher can show toasts, achievement pop-ups and a status line
+// over a running game. Web games reach it through `window.ZontoLauncher` (injected
+// by the launcher's web renderer); native hosts (Node/Electron/etc.) through a
+// loopback HTTP endpoint described by ZONTO_LAUNCHER_URL / ZONTO_LAUNCHER_TOKEN.
+// Both are best-effort and fire-and-forget: they never throw and never block play.
+
+export type ZontoLauncherEvent = {
+  /** Default "toast". */
+  kind?: "toast" | "achievement" | "status";
+  /** Up to 80 characters. */
+  title?: string;
+  /** Up to 200 characters. */
+  body?: string;
+};
+
+type LauncherGlobal = {
+  notify?: (o: { title?: string; body?: string }) => void;
+  achievement?: (name: string, description?: string) => void;
+  setStatus?: (text: string) => void;
+};
+
+function launcherEnv(name: string): string | undefined {
+  try {
+    const p = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process;
+    return p?.env?.[name] || undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** True when this game was started by Volcano OS and can reach its overlay. */
+export function launcherAvailable(): boolean {
+  const g = (globalThis as { ZontoLauncher?: LauncherGlobal }).ZontoLauncher;
+  return !!g || (!!launcherEnv("ZONTO_LAUNCHER_URL") && !!launcherEnv("ZONTO_LAUNCHER_TOKEN"));
+}
+
+/** Send one event to the Volcano OS overlay. Never throws, never needs awaiting. */
+export function launcherNotify(ev: ZontoLauncherEvent, fetchImpl: typeof fetch = fetch.bind(globalThis)): void {
+  try {
+    const web = (globalThis as { ZontoLauncher?: LauncherGlobal }).ZontoLauncher;
+    if (web) {
+      if (ev.kind === "achievement") web.achievement?.(ev.title ?? "", ev.body);
+      else if (ev.kind === "status") web.setStatus?.(ev.body ?? "");
+      else web.notify?.({ title: ev.title, body: ev.body });
+      return;
+    }
+    const url = launcherEnv("ZONTO_LAUNCHER_URL");
+    const token = launcherEnv("ZONTO_LAUNCHER_TOKEN");
+    if (!url || !token) return;
+    void Promise.resolve(
+      fetchImpl(`${url.replace(/\/+$/, "")}/v1/notify`, {
+        method: "POST",
+        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+        body: JSON.stringify(ev),
+      }),
+    ).catch(() => {});
+  } catch {
+    // The overlay is a nicety; it must never interrupt the game.
+  }
+}
