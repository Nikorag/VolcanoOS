+# -- Volcano OS overlay -----------------------------------------------------
+
+## Raise an achievement pop-up on the Volcano OS overlay for each first-time
+## unlock (when the game was started by Volcano OS). Set false to draw your own.
+var launcher_overlay: bool = true
+
+## Descriptions cached by [method achievements] so an unlock pop-up can show
+## one without an extra request: {lowercased name -> description}.
+var _achievement_descriptions: Dictionary = {}
+
+
+## True when Volcano OS started this game and its overlay can be reached.
+func launcher_available() -> bool:
+	if OS.has_feature("web"):
+		return bool(JavaScriptBridge.eval("typeof window.ZontoLauncher !== 'undefined'", true))
+	return not OS.get_environment("ZONTO_LAUNCHER_URL").is_empty() \
+			and not OS.get_environment("ZONTO_LAUNCHER_TOKEN").is_empty()
+
+
+## Sends one event to the Volcano OS overlay: kind is "toast", "achievement"
+## or "status" (title <= 80 chars, body <= 200). Fire-and-forget: it never
+## awaits, never throws, and does nothing unless Volcano OS started the game
+## (or [member enabled] is false, so test suites never touch a launcher).
+func notify_launcher(kind: String, title: String = "", body: String = "") -> void:
+	if not enabled:
+		return
+	if OS.has_feature("web"):
+		var t := JSON.stringify(title)
+		var b := JSON.stringify(body)
+		var call := "window.ZontoLauncher.notify({title:%s,body:%s})" % [t, b]
+		if kind == "achievement":
+			call = "window.ZontoLauncher.achievement(%s,%s)" % [t, b]
+		elif kind == "status":
+			call = "window.ZontoLauncher.setStatus(%s)" % b
+		JavaScriptBridge.eval("if (window.ZontoLauncher) { try { %s } catch (e) {} }" % call)
+		return
+	var url := OS.get_environment("ZONTO_LAUNCHER_URL")
+	var token := OS.get_environment("ZONTO_LAUNCHER_TOKEN")
+	if url.is_empty() or token.is_empty():
+		return
+	var http := HTTPRequest.new()
+	http.timeout = 3.0
+	add_child(http)
+	http.request_completed.connect(func(_r, _c, _h, _b): http.queue_free())
+	var headers := PackedStringArray(["Content-Type: application/json", "Authorization: Bearer %s" % token])
+	var payload := JSON.stringify({"kind": kind, "title": title, "body": body})
+	if http.request(url.rstrip("/") + "/v1/notify", headers, HTTPClient.METHOD_POST, payload) != OK:
+		http.queue_free()
+
+
+## Sets the status line shown in the Volcano OS in-game menu ("Chapter 3").
+func set_launcher_status(text: String) -> void:
+	notify_launcher("status", "", text)
+
+
+func _achievement_description(achievement: Variant) -> String:
+	return String(_achievement_descriptions.get(String(achievement).to_lower(), ""))
+
