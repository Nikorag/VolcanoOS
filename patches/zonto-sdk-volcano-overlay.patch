diff --git a/sdk/test/launcher.test.mjs b/sdk/test/launcher.test.mjs
new file mode 100644
index 0000000..1834406
--- /dev/null
+++ b/sdk/test/launcher.test.mjs
@@ -0,0 +1,108 @@
+/**
+ * Volcano OS overlay bridge: native (env + loopback fetch) and web
+ * (window.ZontoLauncher) paths, and that unlock() raises an achievement pop-up
+ * only for first-time unlocks.
+ *
+ * Run with: npm run test:unit  (needs the dist/ build)
+ */
+import { test, beforeEach, afterEach } from "node:test";
+import assert from "node:assert/strict";
+import { ZontoClient, launcherAvailable, launcherNotify } from "../dist/index.js";
+
+const ENV = ["ZONTO_LAUNCHER_URL", "ZONTO_LAUNCHER_TOKEN"];
+beforeEach(() => {
+  for (const k of ENV) delete process.env[k];
+  delete globalThis.ZontoLauncher;
+});
+afterEach(() => {
+  for (const k of ENV) delete process.env[k];
+  delete globalThis.ZontoLauncher;
+});
+
+function fakeFetch(calls, unlockResult = { ok: true, alreadyUnlocked: false }) {
+  return async (url, init = {}) => {
+    calls.push({ url: String(url), init });
+    const u = String(url);
+    const body = u.includes("/unlock")
+      ? unlockResult
+      : u.endsWith("/api/games/g")
+        ? { achievements: [{ id: 4, name: "Dead Air", description: "Survive the first tide.", rarityPct: 5, unlockedAt: null }] }
+        : { ok: true };
+    return new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } });
+  };
+}
+
+test("not launched from Volcano OS: nothing is sent", () => {
+  const calls = [];
+  assert.equal(launcherAvailable(), false);
+  launcherNotify({ title: "x" }, fakeFetch(calls));
+  assert.equal(calls.length, 0);
+});
+
+test("native: POSTs to the loopback endpoint with the bearer token", async () => {
+  process.env.ZONTO_LAUNCHER_URL = "http://127.0.0.1:5555/";
+  process.env.ZONTO_LAUNCHER_TOKEN = "tok";
+  const calls = [];
+  assert.equal(launcherAvailable(), true);
+  launcherNotify({ kind: "toast", title: "Hi", body: "there" }, fakeFetch(calls));
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, "http://127.0.0.1:5555/v1/notify");
+  assert.equal(calls[0].init.headers.Authorization, "Bearer tok");
+  assert.deepEqual(JSON.parse(calls[0].init.body), { kind: "toast", title: "Hi", body: "there" });
+});
+
+test("native: a failing overlay never throws or rejects", async () => {
+  process.env.ZONTO_LAUNCHER_URL = "http://127.0.0.1:1";
+  process.env.ZONTO_LAUNCHER_TOKEN = "tok";
+  launcherNotify({ title: "x" }, async () => { throw new Error("connection refused"); });
+  await new Promise((r) => setTimeout(r, 10)); // would surface as an unhandled rejection
+});
+
+test("web: uses window.ZontoLauncher", () => {
+  const got = [];
+  globalThis.ZontoLauncher = {
+    notify: (o) => got.push(["notify", o]),
+    achievement: (n, d) => got.push(["achievement", n, d]),
+    setStatus: (t) => got.push(["status", t]),
+  };
+  launcherNotify({ kind: "achievement", title: "A", body: "B" });
+  launcherNotify({ kind: "status", body: "Chapter 3" });
+  launcherNotify({ title: "T", body: "U" });
+  assert.deepEqual(got, [["achievement", "A", "B"], ["status", "Chapter 3"], ["notify", { title: "T", body: "U" }]]);
+});
+
+test("unlock(): first-time unlock raises an achievement pop-up with the description", async () => {
+  process.env.ZONTO_LAUNCHER_URL = "http://127.0.0.1:5555";
+  process.env.ZONTO_LAUNCHER_TOKEN = "tok";
+  const calls = [];
+  const z = new ZontoClient({ baseUrl: "https://z.test", gameSlug: "g", token: "t", fetch: fakeFetch(calls) });
+  await z.achievements(); // primes the description cache
+  await z.unlock("dead air");
+  const notify = calls.filter((c) => c.url.endsWith("/v1/notify"));
+  assert.equal(notify.length, 1);
+  assert.deepEqual(JSON.parse(notify[0].init.body), { kind: "achievement", title: "Dead Air", body: "Survive the first tide." });
+});
+
+test("unlock(): already-unlocked, or launcherOverlay:false, sends nothing", async () => {
+  process.env.ZONTO_LAUNCHER_URL = "http://127.0.0.1:5555";
+  process.env.ZONTO_LAUNCHER_TOKEN = "tok";
+  const again = [];
+  await new ZontoClient({ baseUrl: "https://z.test", gameSlug: "g", token: "t", fetch: fakeFetch(again, { ok: true, alreadyUnlocked: true }) }).unlock("x");
+  assert.equal(again.filter((c) => c.url.endsWith("/v1/notify")).length, 0);
+  const off = [];
+  await new ZontoClient({ baseUrl: "https://z.test", gameSlug: "g", token: "t", launcherOverlay: false, fetch: fakeFetch(off) }).unlock("x");
+  assert.equal(off.filter((c) => c.url.endsWith("/v1/notify")).length, 0);
+});
+
+test("setLauncherStatus() / launcherNotify() convenience methods", () => {
+  process.env.ZONTO_LAUNCHER_URL = "http://127.0.0.1:5555";
+  process.env.ZONTO_LAUNCHER_TOKEN = "tok";
+  const calls = [];
+  const z = new ZontoClient({ baseUrl: "https://z.test", gameSlug: "g", token: "t", fetch: fakeFetch(calls) });
+  z.setLauncherStatus("Chapter 3");
+  z.launcherNotify("Round 2", "Fight!");
+  assert.deepEqual(calls.map((c) => JSON.parse(c.init.body)), [
+    { kind: "status", body: "Chapter 3" },
+    { kind: "toast", title: "Round 2", body: "Fight!" },
+  ]);
+});
