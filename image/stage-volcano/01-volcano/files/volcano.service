[Unit]
Description=Volcano OS (Zonto Volcano launcher)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service
Wants=NetworkManager.service bluetooth.service
# The launcher owns the screen; no login prompt on tty1.
Conflicts=getty@tty1.service
# Keep retrying forever: a console that gives up and shows a black screen is worse than a crash loop.
StartLimitIntervalSec=0

[Service]
Type=simple
User=volcano
# A real logind session on seat0 gives cage DRM/input access and lets the
# launcher's Restart / Shut down buttons work without sudo.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
# Start even with no keyboard/mouse attached (controller-only console).
Environment=WLR_LIBINPUT_NO_DEVICES=1
# -s lets a plugged-in keyboard reach tty2 (Ctrl+Alt+F2) for rescue.
ExecStart=/usr/bin/cage -s -d -- /usr/libexec/volcano/session
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
